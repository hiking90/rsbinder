document = _{ SOI ~ package? ~ imports* ~ decls ~ EOI }

package = { PACKAGE ~ qualified_name ~ ";" }

imports = { import+ }

import = _{ IMPORT ~ qualified_name ~ ";" }

decls = _{ decl+ }

decl = { annotation_list* ~ unannotated_decl }

annotation_list = { annotation+ }

unannotated_decl = _{ parcelable_decl | interface_decl | enum_decl | union_decl }

optional_unstructured_headers = {
    CPP_HEADER ~ C_STR |
    NDK_HEADER ~ C_STR |
    RUST_TYPE ~ C_STR
}

parcelable_decl = {
    PARCELABLE ~ qualified_name ~ optional_type_params ~ "{" ~ parcelable_members* ~ "}" |
    PARCELABLE ~ qualified_name ~ optional_type_params ~ optional_unstructured_headers* ~ ";"
}

interface_decl = {
    INTERFACE ~ qualified_name ~ ";" |
    ONEWAY? ~ INTERFACE ~ qualified_name ~ "{" ~ interface_members? ~ "}"
}

// Iterative: per-member recursion overflows on 1000s of methods, unseen by `check_nesting_depth`.
interface_members = { (method_decl | constant_decl | decl)+ }

constant_decl = {
    annotation_list* ~ CONST ~ type ~ identifier ~ "=" ~ const_expr ~ ";"
}

generic_type1 = {
    "<" ~ type_args ~ "," ~ non_array_type ~ "<" ~ type_args ~ RSHIFT
}

generic_type2 = {
    "<" ~ non_array_type ~ "<" ~ type_args ~ RSHIFT
}

generic_type3 = {
    "<" ~ type_args ~ ">"
}

// annotation_list is removed from non_array_type and array_type and then moved to type.
non_array_type = {
    qualified_name ~
    (
        generic_type1 | generic_type2 | generic_type3
    )?
}

array_type = {
    "[" ~ const_expr? ~ "]"
}

type = {
    annotation_list* ~ non_array_type ~ array_type*
}

type_args = { type ~ ("," ~ type)* }

method_decl = {
    annotation_list* ~ ONEWAY? ~ type ~ identifier ~ "(" ~ arg_list? ~ ")" ~ ";" |
    annotation_list* ~ ONEWAY? ~ type ~ identifier ~ "(" ~ arg_list? ~ ")" ~ "=" ~ INTVALUE ~ ";"
}

direction = @{ (INOUT | IN | OUT) ~ WORD_END }

// A single direction, as AOSP `aidl_language_y.yy` (`direction: IN | OUT | INOUT | empty`).
arg = {
    direction? ~ type ~ identifier
}

arg_list = { arg ~ ("," ~ arg)* }

enumerator = {
    identifier ~ "=" ~ const_expr |
    identifier
}

enumerators = _{ enumerator ~ ("," ~ enumerator)* }

enum_decl_body = _{
    "{" ~ enumerators ~ "}" |
    "{" ~ enumerators ~ "," ~ "}"
}

enum_decl = { ENUM ~ qualified_name ~ enum_decl_body }

union_decl = { UNION ~ qualified_name ~ optional_type_params ~ "{" ~ parcelable_members* ~ "}" }

// AOSP `type_parameter` may be annotated, as in `MQDescriptor<@FixedSize T, Flavor>`.
type_param = { annotation_list* ~ identifier }

optional_type_params = { ("<" ~ type_param ~ ("," ~ type_param)* ~ ">")? }

variable_decl = {
    type ~ identifier ~ "=" ~ const_expr ~ ";" |
    type ~ identifier ~ ";"
}

parcelable_members = { (variable_decl | constant_decl | decl)+ }

// AOSP `aidl_language_l.ll` tokens that `identifier` (`aidl_language_y.yy`) does not accept.
// A longer word precedes its prefix (`inout`, `interface` before `in`): no backtracking.
keywords = @{
    (
        "interface" | "parcelable" | "package" | "import" | "inout" | "in" | "out" | "oneway" |
        "const" | "enum" | "union" | "true" | "false"
    ) ~ WORD_END
}

// The flex lexer takes the longest token, so a keyword is a whole word (`interfaceI` is a name).
WORD_END = _{ !("_" | ASCII_ALPHANUMERIC) }

parameter = { identifier ~ "=" ~ const_expr }

parameter_list = { parameter ~ ("," ~ parameter)* }

annotation = {
    ANNOTATION ~ "(" ~ const_expr ~ ")" |
    ANNOTATION ~ "(" ~ parameter_list? ~ ")" |
    ANNOTATION
}

qualified_name = @{ identifier ~ ("." ~ identifier)* }

identifier = { !keywords ~ (IDENTIFIER | CPP_HEADER | NDK_HEADER | RUST_TYPE) }

constant_value_list = { const_expr ~ ("," ~ const_expr)* ~ ","? }

const_expr = {
    "{" ~ constant_value_list? ~ "}" |
    CHARVALUE | expression
}

// C precedence as AOSP aidl_language_y.yy: `a & M == M` is `a & (M == M)`, as in AOSP aidl.
expression = { logical_or ~ (logical_or_op ~ logical_or)* }
logical_or_op = { LOGICAL_OR }
logical_or = { logical_and ~ (logical_and_op ~ logical_and)* }
logical_and_op = { LOGICAL_AND }
logical_and = { bitwise_or ~ (bitwise_or_op ~ bitwise_or)* }
bitwise_or_op = { "|" }
bitwise_or = { bitwise_xor ~ (bitwise_xor_op ~ bitwise_xor)* }
bitwise_xor_op = { "^" }
bitwise_xor = { bitwise_and ~ (bitwise_and_op ~ bitwise_and)* }
bitwise_and_op = { "&" }
bitwise_and = { equality ~ (equality_op ~ equality)* }
equality_op = { EQUALITY | NEQ }
equality = { comparison ~ (comparison_op ~ comparison)* }
comparison_op = { LEQ | GEQ | LT | GT }
comparison = { shift ~ (shift_op ~ shift)* }
shift_op = { LSHIFT | RSHIFT }
shift = { arith ~ (arith_op ~ arith)* }
arith_op = { "+" | "-" }
arith = { factor ~ (factor_op ~ factor)* }
factor_op = { "*" | "/" | "%" }
factor = { "(" ~ expression ~ ")" | unary | value }
unary = { unary_op ~ factor }
unary_op = { "+" | "-" | "!" | "~" }

// One expression grammar for C_STR too, as AOSP; type mixing is rejected at evaluation.
value = {
    TRUE_LITERAL | FALSE_LITERAL | HEXVALUE | FLOATVALUE | INTVALUE |
    C_STR | qualified_name
}

ANNOTATION = @{ "@" ~ identifier }

// `&keywords` keeps a keyword whole without implicit whitespace; none here prefixes another.
INTERFACE = _{ &keywords ~ "interface" }
PACKAGE = _{ &keywords ~ "package" }
IMPORT = _{ &keywords ~ "import" }
ONEWAY = @{ "oneway" ~ WORD_END }
CONST = _{ &keywords ~ "const" }
RSHIFT = { ">>" }
LSHIFT = { "<<" }
IN = { "in" }
OUT = { "out" }
INOUT = { "inout" }
ENUM = _{ &keywords ~ "enum" }
UNION = _{ &keywords ~ "union" }
CPP_HEADER = { "cpp_header" }
NDK_HEADER = { "ndk_header" }
RUST_TYPE = { "rust_type" }
PARCELABLE = _{ &keywords ~ "parcelable" }
IDENTIFIER = @{ ("_" | ASCII_ALPHA)+ ~ ("_" | ASCII_ALPHA | ASCII_DIGIT)* }
TRUE_LITERAL = @{ "true" ~ WORD_END }
FALSE_LITERAL = @{ "false" ~ WORD_END }
CHARVALUE = @{ "'" ~ ("\\" ~ ANY | !"'" ~ ANY) ~ "'" }
INT_SUFFIX = _{ "l" | "L" | "u8" | "u32" | "u64" }
// `_` between digits (AOSP `1_000_000`); suffixes are AOSP's u8/u32/u64/l/L.
INTVALUE = @{ ASCII_DIGIT ~ ("_"? ~ ASCII_DIGIT)* ~ INT_SUFFIX? }
HEXVALUE = @{ "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT ~ ("_"? ~ ASCII_HEX_DIGIT)* ~ INT_SUFFIX? }
// No PEG backtracking: each shape needs `.`, exponent or `f`, so a bare int falls to INTVALUE.
FLOATVALUE = @{
    (ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("-" | "+")? ~ ASCII_DIGIT+)? ~ "f"?)
  | ("." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("-" | "+")? ~ ASCII_DIGIT+)? ~ "f"?)
  | (ASCII_DIGIT+ ~ ("e" | "E") ~ ("-" | "+")? ~ ASCII_DIGIT+ ~ "f"?)
  | (ASCII_DIGIT+ ~ "f")
}
// `\X` first so `\"` does not end the string; `parse_c_str` then rejects the backslash.
C_STR = @{ "\"" ~ ( "\\" ~ ANY | !("\"") ~ ANY)* ~ "\"" }

LOGICAL_OR = { "||" }
LOGICAL_AND = { "&&" }
EQUALITY = { "==" }
NEQ = { "!=" }
LEQ = { "<=" }
GEQ = { ">=" }
LT = @{ !"<<" ~ "<" }
GT = @{ !">>" ~ ">" }

LONG_COMMENT = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
// EOI also ends a `//` comment: a file may end in a comment without a trailing newline.
LINE_COMMENT = _{ "//" ~ (!"\n" ~ ANY)* ~ ("\n" | EOI) }
COMMENT = _{ LONG_COMMENT | LINE_COMMENT }
WHITESPACE = _{ (" " | "\t" | "\r" | "\n")+ }

rust_derive = { (IDENTIFIER ~ "=" ~ (TRUE_LITERAL | FALSE_LITERAL) ~ ","?)+ }
